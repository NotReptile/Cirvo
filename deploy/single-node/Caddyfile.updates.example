# Place before the fallback handle inside the Cirvo HTTPS site.
# Mount /srv/cirvo/updates read-only into the reverse-proxy container.
handle_path /updates/* {
  forward_auth core-api:8080 {
    uri /api/v1/users/me
  }
  root * /srv/cirvo/updates
  header Cache-Control "private, no-store"
  file_server
}
