RUCORD_ENV=local
RUCORD_STAGE=dev

# Postgres
POSTGRES_DB=rucord
POSTGRES_USER=rucord
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
# Optional alternative to POSTGRES_* parts:
# RUCORD_POSTGRES_DSN=postgres://rucord:change-me@127.0.0.1:5432/rucord?sslmode=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# RUCORD_REDIS_ADDR=127.0.0.1:6379

# Object storage
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Auth / JWT (must be at least 32 characters)
RUCORD_JWT_SECRET=replace-me-with-at-least-32-bytes-random
RUCORD_JWT_ACCESS_TTL=15m

# Bootstrap первого администратора. Применяется ОДИН РАЗ при первом запуске
# core-api на пустой БД (когда в таблице users нет ни одной записи). После
# успешного bootstrap эти переменные можно убрать или оставить — повторно
# они не используются. Если они не заданы при первом запуске, первому
# админу придётся зарегистрироваться через POST /api/v1/auth/register.
# RUCORD_BOOTSTRAP_EMAIL=admin@example.com
# RUCORD_BOOTSTRAP_USERNAME=admin
# RUCORD_BOOTSTRAP_PASSWORD=replace-me-min-8-chars
# RUCORD_BOOTSTRAP_DISPLAY_NAME=Администратор
# RUCORD_BOOTSTRAP_WORKSPACE_SLUG=main
# RUCORD_BOOTSTRAP_WORKSPACE_NAME=Главный сервер

# Desktop client targets
RUCORD_API_BASE_URL=http://127.0.0.1:8080
RUCORD_REALTIME_URL=ws://127.0.0.1:8090/ws

# CORS allow-list для core-api (через запятую). Пустое значение оставляет
# дефолт для локальной разработки (Tauri + 127.0.0.1:1420). В production
# обязательно указать конечный список схем+хостов, без `*`.
# RUCORD_CORS_ORIGINS=https://chat.example.com,tauri://localhost
# Static-IP HTTP test mode:
# RUCORD_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://127.0.0.1:1420,http://localhost:1420,http://<STATIC_IP>

# --- single-node deploy (deploy/single-node/docker-compose.yml) ---
# Публичное имя хоста, под которым доступен сервер. Для self-host без
# публичного DNS можно поставить IP/локальное имя — но тогда RUCORD_TLS_EMAIL
# должен быть `internal` (Caddy выдаст self-signed сертификат).
RUCORD_DOMAIN=localhost
# Email для Let's Encrypt ACME. Литерал `internal` => self-signed CA Caddy.
RUCORD_TLS_EMAIL=internal
# Куда reverse-proxy шлёт API/WS. По умолчанию host.docker.internal — то
# есть сервисы core-api/realtime запущены как host-процессы рядом. Если
# поднимаешь их контейнерами в том же compose — поставь имя сервиса.
RUCORD_UPSTREAM_HOST=host.docker.internal

# WebRTC ICE-серверы (отдаются через GET /api/v1/ice-servers).
# Несколько STUN — через запятую. TURN опционален; если не задан, отдадим
# только STUN. coturn в docker-compose поднимается профилем `turn`.
ICE_STUN_URLS=stun:stun.l.google.com:19302
# ICE_TURN_URL=turn:127.0.0.1:3478
# ICE_TURN_USERNAME=rucord
# ICE_TURN_CREDENTIAL=change-me
# TURN_REALM=rucord.local
# TURN_USERNAME=rucord
# TURN_PASSWORD=change-me

# --- SFU (F.2): групповой голос >5 участников ------------------------------
# По умолчанию выключен — клиенты работают в mesh (до 5 человек). Чтобы
# включить, раскомментируй обе строки ниже и подними стек с профилем `sfu`:
#   docker compose -f deploy/single-node/docker-compose.yml \
#     --env-file deploy/.env --profile sfu up -d --build
#
# RUCORD_SFU_URL — адрес WS-сигналинга, который core-api отдаёт клиентам
# в GET /api/v1/ice-servers. Непустой = SFU включён, потолок канала 50.
# RUCORD_SFU_PUBLIC_IP — публичный IP сервера (NAT 1:1 для медиа). Без
# него ICE анонсирует только внутренние docker-адреса, и звук не пройдёт
# из интернета. На чистом LAN можно не задавать.
# RUCORD_SFU_UDP_PORT — порт RTP-медиа (UDP). Пробросить на роутере (UDP).
# RUCORD_SFU_URL=wss://rucord-home.duckdns.org/sfu/ws
# RUCORD_SFU_PUBLIC_IP=<PUBLIC_IP>
# RUCORD_SFU_UDP_PORT=50000
