CIRVO_ENV=local
CIRVO_STAGE=dev

# Postgres
POSTGRES_DB=rucord
POSTGRES_USER=rucord
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable
# Optional alternative to POSTGRES_* parts:
# CIRVO_POSTGRES_DSN=postgres://rucord:change-me@127.0.0.1:5432/rucord?sslmode=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# CIRVO_REDIS_ADDR=127.0.0.1:6379

# Object storage
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Auth / JWT (must be at least 32 characters)
CIRVO_JWT_SECRET=replace-me-with-at-least-32-bytes-random
CIRVO_JWT_ACCESS_TTL=15m

# Bootstrap первого администратора. Применяется ОДИН РАЗ при первом запуске
# core-api на пустой БД (когда в таблице users нет ни одной записи). После
# успешного bootstrap эти переменные можно убрать или оставить — повторно
# они не используются. Если они не заданы при первом запуске, первому
# админу придётся зарегистрироваться через POST /api/v1/auth/register.
# CIRVO_BOOTSTRAP_EMAIL=admin@example.com
# CIRVO_BOOTSTRAP_USERNAME=admin
# CIRVO_BOOTSTRAP_PASSWORD=replace-me-min-8-chars
# CIRVO_BOOTSTRAP_DISPLAY_NAME=Администратор
# CIRVO_BOOTSTRAP_WORKSPACE_SLUG=main
# CIRVO_BOOTSTRAP_WORKSPACE_NAME=Главный сервер

# CORS allow-list для core-api (через запятую). Пустое значение оставляет
# дефолт для локальной разработки (Tauri + 127.0.0.1:1420). В production
# обязательно указать конечный список схем+хостов, без `*`.
# Windows-клиент (WebView2) ходит с http://tauri.localhost, поэтому все три
# Tauri-оригина обязательны: без них клиент получит CORS-ошибку на первом экране.
# CIRVO_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Static-IP HTTP test mode:
# CIRVO_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://127.0.0.1:1420,http://localhost:1420,http://<STATIC_IP>

# --- single-node deploy (deploy/single-node/docker-compose.yml) ---
# Публичное имя хоста, под которым доступен сервер. Для self-host без
# публичного DNS можно поставить IP/локальное имя — но тогда CIRVO_TLS_EMAIL
# должен быть `internal` (Caddy выдаст self-signed сертификат).
CIRVO_DOMAIN=chat.example.com
# Email для Let's Encrypt ACME. Литерал `internal` => self-signed CA Caddy.
CIRVO_TLS_EMAIL=admin@example.com

# WebRTC ICE-серверы (отдаются через GET /api/v1/ice-servers).
# Несколько STUN/TURN URL — через запятую. В single-node coturn и SFU
# запускаются всегда; mesh остаётся режимом локальной разработки.
# ICE_STUN_URLS не нужен: пока он пуст, STUN отвечает тот же coturn (адрес
# берётся из ICE_TURN_URLS). Публичные серверы вроде Google не используются.
# ICE_STUN_URLS=
ICE_TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# Общий секрет coturn REST API. Сгенерировать: openssl rand -hex 32
# Клиентам выдаются производные credentials сроком на один час.
ICE_TURN_SHARED_SECRET=replace-with-random-turn-secret
# Legacy static credentials используются только если shared secret пуст.
# ICE_TURN_URL=turn:127.0.0.1:3478
# ICE_TURN_USERNAME=rucord
# ICE_TURN_CREDENTIAL=change-me
# TURN_REALM=rucord.local
# TURN_USERNAME=rucord
# TURN_PASSWORD=change-me

# --- SFU (F.2): групповой голос >5 участников ------------------------------
# В production SFU включён всегда. Для локального mesh явно оставь
# CIRVO_SFU_URL пустым и запускай сервисы вне single-node compose.
#
# CIRVO_SFU_URL — адрес WS-сигналинга, который core-api отдаёт клиентам
# в GET /api/v1/ice-servers. Непустой = SFU включён, потолок канала 50.
# CIRVO_SFU_PUBLIC_IP — публичный IP сервера (NAT 1:1 для медиа). Без
# него ICE анонсирует только внутренние docker-адреса, и звук не пройдёт
# из интернета. Обязателен в production: без него SFU не стартует, а Caddy
# ждёт здорового SFU. В LAN-сценарии укажи LAN-адрес сервера.
# CIRVO_SFU_UDP_PORT — порт RTP-медиа (UDP). Пробросить на роутере (UDP).
CIRVO_SFU_URL=wss://chat.example.com/sfu/ws
CIRVO_SFU_PUBLIC_IP=203.0.113.10
CIRVO_SFU_UDP_PORT=50000
