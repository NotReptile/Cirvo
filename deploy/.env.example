RUCORD_ENV=local
RUCORD_STAGE=dev

# Postgres
POSTGRES_DB=rucord
POSTGRES_USER=rucord
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# Optional alternative to POSTGRES_* parts:
# RUCORD_POSTGRES_DSN=postgres://rucord:change-me@127.0.0.1:5432/rucord?sslmode=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# RUCORD_REDIS_ADDR=127.0.0.1:6379

# Object storage
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Auth / JWT (must be at least 32 characters)
RUCORD_JWT_SECRET=replace-me-with-at-least-32-bytes-random
RUCORD_JWT_ACCESS_TTL=15m

# Desktop client targets
RUCORD_API_BASE_URL=http://127.0.0.1:8080
RUCORD_REALTIME_URL=ws://127.0.0.1:8090/ws
