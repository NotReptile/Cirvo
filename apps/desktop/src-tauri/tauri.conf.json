{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cirvo",
  "version": "0.3.1",
  "identifier": "com.cirvo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NTI2NzQyOTJCMUYxQTkKUldTcDhiR1NRbWRTUk1uc1JzR2M5d3B1dXFBQ3JnVzBEdVpwRHFHYjhGeDVuWDF6bjJKQ0ZJaUEK",
      "endpoints": []
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cirvo",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' blob: data: https: http:; media-src 'self' blob: data: https: http:; connect-src 'self' ipc: http://ipc.localhost https: wss: http: ws:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "shortDescription": "Cirvo — self-host чат и голос",
    "longDescription": "Cirvo — self-host чат и голос для дружеских кружков и небольших сообществ.",
    "copyright": "© Cirvo",
    "publisher": "Cirvo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
