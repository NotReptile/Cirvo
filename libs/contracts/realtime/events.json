{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cirvo.local/contracts/realtime-envelope-v2.json",
  "title": "RealtimeEnvelopeV2",
  "type": "object",
  "properties": {
    "version": { "const": 2 },
    "seq": { "type": "integer", "minimum": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "event": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "format": "uuid" },
    "channelId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "payload": {}
  },
  "required": ["version", "event", "payload"],
  "oneOf": [
    {
      "properties": { "event": { "enum": ["sync.ready", "sync.required", "presence.snapshot"] } }
    },
    {
      "required": ["seq", "eventId", "occurredAt"]
    }
  ],
  "additionalProperties": false
}
